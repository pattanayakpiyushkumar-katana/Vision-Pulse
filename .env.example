# ==============================================================================
# VisionPulse AI — Environment Template (Client, Server & Backend)
# ==============================================================================

# Backend / Server (Render + Supabase)
PORT=5000
NODE_ENV=production
RENDER=true
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
JWT_SECRET=replace_with_32_byte_cryptographic_secret
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key
CLIENT_URL=https://your-visionpulse-app.vercel.app
VERCEL_URL=https://your-visionpulse-app.vercel.app

# Client (Vercel)
VITE_API_BASE_URL=https://your-visionpulse-app.onrender.com/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
